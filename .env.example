# VS Code client key AND dashboard login password
PROXY_CLIENT_KEY=""

# Your OpenCode Go API key
OPENCODE_GO_API_KEY=""

# Model to use
OPENCODE_GO_MODEL="deepseek-v4.1-flash"

#
OPENCODE_ENDPOINT="https://opencode.ai/inference/go/openai/v1/chat/completions"

DASHBOARD_PASSWORD=""

# Dev diagnostics: capture full client/upstream request and response bodies
# in proxy-debug.jsonl. Never enable this in production — bodies contain prompts.
PROXY_DEBUG=false
# Max bytes captured per body (default 262144 = 256 KiB)
PROXY_DEBUG_MAX_BYTES=262144
# Total debug log size before older lines are trimmed (default 10485760 = 10 MiB)
PROXY_DEBUG_LOG_BYTES=10485760
# Comma-separated body parameters removed before forwarding. OpenCode Go
# rejects trace_id, so it is stripped recursively (including input items).
PROXY_STRIP_PARAMS=trace_id

# Privacy protection
PRIVACY_SCRUB_ENABLED=true
PRIVACY_REDACT_EMAILS=true
PRIVACY_REDACT_IPS=true
PRIVACY_REDACT_PHONES=true
PRIVACY_REDACT_CARDS=true
PRIVACY_REDACT_UK_POSTCODES=true
PRIVACY_REDACT_NI_NUMBERS=true
PRIVACY_REDACT_SECRETS=true
PRIVACY_REDACT_DOBS=true
PRIVACY_REDACT_ADDRESSES=true